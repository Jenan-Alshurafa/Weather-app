# API Keys Configuration
# Copy this file to .env and replace the placeholder values with your actual API keys
# The .env file is gitignored and will not be committed to version control

# RapidAPI Key for GeoDB Cities API
# Get your key from: https://rapidapi.com/wirefreethought/api/geodb-cities
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=wft-geo-db.p.rapidapi.com

# OpenWeatherMap API Key
# Get your key from: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your_openweather_api_key_here
